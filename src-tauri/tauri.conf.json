{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinq",
  "version": "0.2.0",
  "identifier": "dev.pinq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MkU4MDUzOEI0RDMzRDEKUldUUk0wMkxVNEF1V0J2SFRKbWdUUFcxWnRzYjhhZnp6M094QUd1V2tTMUowV0ppK0l3bDdoOWEK",
      "endpoints": [
        "https://github.com/Mininoob/pinq/releases/latest/download/latest.json"
      ]
    }
  }
}
