      "css": ".ds-chips{display:flex;gap:8px;margin:0;padding:0;list-style:none}.ds-chip{display:inline-flex;align-items:center;height:32px;padding:0 13px;border:1px solid rgba(36,35,34,.12);border-radius:999px;background:rgba(250,249,246,.6);font:500 13.5px \"Geist\",system-ui,sans-serif;color:#57534d}"
    },
    {
