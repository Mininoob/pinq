  "components": [
    {
      "name": "Ink Pill Button",
      "kind": "button",
      "refersTo": "button-ink",
      "description": "The primary CTA (Download). Ink pill with a pooled lift shadow.",
      "html": "<a class=\"ds-btn-ink\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Download free</a>",
      "css": ".ds-btn-ink{display:inline-flex;align-items:center;gap:9px;height:48px;padding:0 22px;border-radius:999px;background:#242322;color:#faf9f6;font:600 15.5px/1 \"Geist\",system-ui,sans-serif;letter-spacing:-0.01em;text-decoration:none;white-space:nowrap;box-shadow:0 8px 20px -10px rgba(36,35,34,.55);transition:transform .25s cubic-bezier(.16,1,.3,1),background-color .2s,box-shadow .25s cubic-bezier(.16,1,.3,1)}.ds-btn-ink:hover{background:#0f0f0e;transform:translateY(-1px);box-shadow:0 14px 26px -12px rgba(36,35,34,.6)}.ds-btn-ink:active{transform:translateY(1px) scale(.985)}.ds-btn-ink:focus-visible{outline:2px solid #242322;outline-offset:3px}"
    },
    {
      "name": "Ghost Pill Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action beside the ink CTA.",
      "html": "<a class=\"ds-btn-ghost\" href=\"#\">View on GitHub</a>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;gap:9px;height:48px;padding:0 22px;border-radius:999px;background:rgba(36,35,34,.06);color:#242322;font:600 15.5px/1 \"Geist\",system-ui,sans-serif;letter-spacing:-0.01em;text-decoration:none;transition:background-color .2s,transform .25s cubic-bezier(.16,1,.3,1)}.ds-btn-ghost:hover{background:rgba(36,35,34,.11)}.ds-btn-ghost:active{transform:translateY(1px) scale(.985)}.ds-btn-ghost:focus-visible{outline:2px solid #242322;outline-offset:3px}"
    },
    {
      "name": "Paper Pill Button",
      "kind": "button",
      "refersTo": "button-paper",
      "description": "The accent button, used only on the ink band.",
