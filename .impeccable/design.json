      "css": ".ds-band{background:#242322;padding:32px}.ds-btn-paper{display:inline-flex;align-items:center;height:48px;padding:0 22px;border-radius:999px;background:#ffd45c;color:#242322;font:600 15.5px/1 \"Geist\",system-ui,sans-serif;letter-spacing:-0.01em;text-decoration:none;box-shadow:0 10px 24px -12px rgba(255,212,92,.55);transition:transform .25s cubic-bezier(.16,1,.3,1),background-color .2s}.ds-btn-paper:hover{background:#ffdc76;transform:translateY(-1px)}.ds-btn-paper:active{transform:translateY(1px) scale(.985)}.ds-btn-paper:focus-visible{outline:2px solid #ffd45c;outline-offset:3px}"
    },
    {
